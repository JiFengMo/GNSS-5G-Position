{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Core algorithms",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BDS5G_BUILD_TESTS": "ON",
        "BDS5G_BUILD_LEGACY_NR": "OFF"
      }
    },
    {
      "name": "uhd",
      "displayName": "Core algorithms and UHD NR receiver",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-uhd",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BDS5G_BUILD_TESTS": "ON",
        "BDS5G_BUILD_LEGACY_NR": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "default", "configurePreset": "default"},
    {"name": "uhd", "configurePreset": "uhd"}
  ],
  "testPresets": [
    {"name": "default", "configurePreset": "default", "output": {"outputOnFailure": true}}
  ]
}

